# ─────────────────────────────────────────────────────────────
# AquaCop Environment Variables (.env.example)
# Copy this file to .env and fill in real values for your environment.
# NEVER commit the real .env file with secrets into version control.
# ─────────────────────────────────────────────────────────────

# Backend Security (Change in production)
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key

# Database Connection (Default SQLite inside container volume)
DATABASE_URL=sqlite:////app/data/aquacop.db

# Cache Directory for STAC GeoTIFFs and analytical tiles
CACHE_DIR=/app/cache

# Port bindings
BACKEND_PORT=8000
FRONTEND_PORT=3000
PROXY_PORT=80

# Frontend API Target (leave blank to proxy through Nginx port 80)
NEXT_PUBLIC_API_URL=

# Release / Image Version Tagging
AQUACOP_VERSION=latest
